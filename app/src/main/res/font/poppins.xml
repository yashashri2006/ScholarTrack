<?xml version="1.0" encoding="utf-8"?>
<!-- Poppins Regular font definition. Using sans-serif as fallback.
     To use actual Poppins, download TTF files from Google Fonts into res/font/
     and update this file to reference them. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/poppins_regular_ttf"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/poppins_regular_ttf"
        app:fontStyle="normal"
        app:fontWeight="400" />
</font-family>
