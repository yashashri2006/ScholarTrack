<?xml version="1.0" encoding="utf-8"?>
<!-- Unit 2: Externalised style resources. Material 3 text appearances and component styles. -->
<resources>

    <!-- ============ Text Styles ============ -->
    <style name="TextStyle" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextStyle.HeadlineLarge">
        <item name="android:textSize">@dimen/text_headline_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.HeadlineMedium">
        <item name="android:textSize">@dimen/text_headline_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextStyle.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline_small</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
    </style>

    <style name="TextStyle.TitleLarge">
        <item name="android:textSize">@dimen/text_title_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextStyle.TitleMedium">
        <item name="android:textSize">@dimen/text_title_medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextStyle.BodyLarge">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextStyle.BodyMedium">
        <item name="android:textSize">@dimen/text_body_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextStyle.BodySmall">
        <item name="android:textSize">@dimen/text_body_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <style name="TextStyle.LabelLarge">
        <item name="android:textSize">@dimen/text_label_large</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextStyle.LabelMedium">
        <item name="android:textSize">@dimen/text_label_medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <style name="TextStyle.OnPrimary">
        <item name="android:textSize">@dimen/text_body_large</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:fontFamily">@font/poppins</item>
    </style>

    <!-- ============ Card Styles ============ -->
    <style name="Widget.ScholarTrack.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <style name="Widget.ScholarTrack.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
    </style>

    <!-- ============ Button Styles ============ -->
    <style name="Widget.ScholarTrack.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label_large</item>
    </style>

    <style name="Widget.ScholarTrack.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label_large</item>
    </style>

    <style name="Widget.ScholarTrack.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_label_large</item>
    </style>

    <!-- ============ TextInputLayout Style ============ -->
    <style name="Widget.ScholarTrack.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_radius</item>
        <item name="hintTextAppearance">@style/TextStyle.LabelMedium</item>
    </style>

    <!-- ============ Chip Styles ============ -->
    <style name="Widget.ScholarTrack.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">@dimen/chip_radius</item>
        <item name="android:textSize">@dimen/text_label_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
    </style>

    <!-- ============ Bottom Navigation Style ============ -->
    <style name="Widget.ScholarTrack.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="itemTextAppearanceActive">@style/TextStyle.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextStyle.LabelMedium</item>
    </style>

    <!-- ============ Toolbar ============ -->
    <style name="Widget.ScholarTrack.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextStyle.TitleLarge</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
    </style>

    <!-- ============ Splash Animation ============ -->
    <style name="SplashTitle">
        <item name="android:textSize">@dimen/splash_title_size</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SplashTagline">
        <item name="android:textSize">@dimen/splash_tagline_size</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="android:textStyle">italic</item>
    </style>

</resources>
