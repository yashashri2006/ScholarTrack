<?xml version="1.0" encoding="utf-8"?>
<!-- Coordinator Help Fragment layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/spacing_md">

    <TextView
        style="@style/TextStyle.HeadlineMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Coordinator Portal" />

    <TextView
        style="@style/TextStyle.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_sm"
        android:gravity="center"
        android:text="Review applications, mark hard copies signed, and assist students." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCoordLogout"
        style="@style/Widget.ScholarTrack.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_xl"
        android:text="@string/logout" />
</LinearLayout>
