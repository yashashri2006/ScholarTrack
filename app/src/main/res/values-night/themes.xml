<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Unit 2: Material 3 Dark Theme for ScholarTrack -->
    <style name="Base.Theme.ScholarTrack" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand colour -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        <item name="colorPrimaryContainer">@color/dark_surface_variant</item>

        <!-- Secondary / Accent -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <item name="colorSecondaryContainer">@color/dark_surface_variant</item>

        <!-- Surface and background -->
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorSurfaceVariant">@color/dark_surface_variant</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:textColorHint">@color/dark_text_secondary</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_surface</item>

        <!-- Default widget styles -->
        <item name="materialCardViewStyle">@style/Widget.ScholarTrack.Card</item>
        <item name="materialButtonStyle">@style/Widget.ScholarTrack.Button</item>
        <item name="textInputStyle">@style/Widget.ScholarTrack.TextInputLayout</item>
        <item name="bottomNavigationStyle">@style/Widget.ScholarTrack.BottomNav</item>

        <!-- Font family -->
        <item name="android:fontFamily">@font/poppins</item>

        <!-- Ripple -->
        <item name="android:colorControlHighlight">@color/ripple_dark</item>
    </style>
</resources>